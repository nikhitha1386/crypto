#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void findPosition(char ch, int *r, int *c) {
    int i, j;

    if(ch == 'J')
        ch = 'I';

    for(i = 0; i < 5; i++)
        for(j = 0; j < 5; j++)
            if(matrix[i][j] == ch) {
                *r = i;
                *c = j;
            }
}

int main() {
    char text[] =
    "MUST SEE YOU OVER CADOGAN WEST COMING AT ONCE";

    char clean[100], result[100];
    int i, n = 0, pos = 0;
    int r1, c1, r2, c2;
    char a, b;

    /* Remove spaces */
    for(i = 0; text[i] != '\0'; i++) {
        if(isalpha(text[i])) {
            a = toupper(text[i]);

            if(a == 'J')
                a = 'I';

            clean[n++] = a;
        }
    }

    /* Add X if required */
    if(n % 2 != 0)
        clean[n++] = 'X';

    clean[n] = '\0';

    for(i = 0; i < n; i += 2) {

        a = clean[i];
        b = clean[i + 1];

        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);

        if(r1 == r2) {
            result[pos++] =
                matrix[r1][(c1 + 1) % 5];

            result[pos++] =
                matrix[r2][(c2 + 1) % 5];
        }
        else if(c1 == c2) {
            result[pos++] =
                matrix[(r1 + 1) % 5][c1];

            result[pos++] =
                matrix[(r2 + 1) % 5][c2];
        }
        else {
            result[pos++] = matrix[r1][c2];
            result[pos++] = matrix[r2][c1];
        }
    }

    result[pos] = '\0';

    printf("Prepared text: %s\n", clean);
    printf("Ciphertext: %s\n", result);

    return 0;
}
