#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void createMatrix(char key[]) {
    int used[26] = {0};
    int r = 0, c = 0, i;
    char ch;

    for(i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);

        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z' && !used[ch-'A']) {
            matrix[r][c++] = ch;
            used[ch-'A'] = 1;

            if(c == 5) {
                c = 0;
                r++;
            }
        }
    }

    for(ch = 'A'; ch <= 'Z'; ch++) {
        if(ch == 'J')
            continue;

        if(!used[ch-'A']) {
            matrix[r][c++] = ch;
            used[ch-'A'] = 1;

            if(c == 5) {
                c = 0;
                r++;
            }
        }
    }
}

void findPosition(char ch, int *r, int *c) {
    int i, j;

    if(ch == 'J')
        ch = 'I';

    for(i = 0; i < 5; i++)
        for(j = 0; j < 5; j++)
            if(matrix[i][j] == ch) {
                *r = i;
                *c = j;
            }
}

int main() {
    char key[50];
    char cipher[] =
    "KXJEYUREBEZWEHEWRYTUHEYFS"
    "KREHEGOYFIWTTTUOLKSYCAJPO"
    "BOTEIZONTXBYBNTGONE YCUZWR"
    "GDSONSXBOUYWRHEBAAHYUSEDQ";

    int i, r1, c1, r2, c2;
    char a, b;

    printf("Enter Playfair keyword: ");
    scanf("%s", key);

    createMatrix(key);

    printf("\nMatrix:\n");

    for(i = 0; i < 5; i++) {
        for(int j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    printf("\nDecrypted text:\n");

    for(i = 0; cipher[i] != '\0'; i += 2) {

        if(cipher[i] == ' ')
            i++;

        a = cipher[i];
        b = cipher[i + 1];

        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);

        if(r1 == r2) {
            printf("%c", matrix[r1][(c1 + 4) % 5]);
            printf("%c", matrix[r2][(c2 + 4) % 5]);
        }
        else if(c1 == c2) {
            printf("%c", matrix[(r1 + 4) % 5][c1]);
            printf("%c", matrix[(r2 + 4) % 5][c2]);
        }
        else {
            printf("%c", matrix[r1][c2]);
            printf("%c", matrix[r2][c1]);
        }
    }

    return 0;
}
