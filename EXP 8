#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char key[] = "CIPHER";
    char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    char cipher[27];
    char text[100], result[100];
    int used[26] = {0};
    int i, j = 0, k;

    /* Add keyword letters */
    for(i = 0; key[i] != '\0'; i++) {
        k = key[i] - 'A';

        if(!used[k]) {
            cipher[j++] = key[i];
            used[k] = 1;
        }
    }

    /* Add remaining alphabet letters */
    for(i = 0; i < 26; i++) {
        if(!used[i])
            cipher[j++] = alphabet[i];
    }

    cipher[26] = '\0';

    printf("Cipher alphabet: %s\n", cipher);

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    for(i = 0; text[i] != '\0'; i++) {
        if(isalpha(text[i])) {
            if(isupper(text[i]))
                result[i] = cipher[text[i] - 'A'];
            else
                result[i] = tolower(cipher[text[i] - 'a']);
        }
        else {
            result[i] = text[i];
        }
    }

    result[i] = '\0';

    printf("Ciphertext: %s", result);

    return 0;
}
