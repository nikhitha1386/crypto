#include <stdio.h>
#include <string.h>

void decrypt(char text[], int shift) {
    int i;

    for(i = 0; text[i] != '\0'; i++) {
        if(text[i] >= 'A' && text[i] <= 'Z')
            printf("%c",
                (text[i]-'A'-shift+26)%26+'A');
        else
            printf("%c", text[i]);
    }

    printf("\n");
}

int main() {

    char cipher[200];
    int i;

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    printf("\nPossible plaintexts:\n");

    for(i = 0; i < 26; i++) {
        printf("Shift %2d: ", i);
        decrypt(cipher, i);
    }

    return 0;
}
