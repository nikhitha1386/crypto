#include <stdio.h>
#include <string.h>

int main() {
    char text[100], result[100];
    int k, i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key (1-25): ");
    scanf("%d", &k);

    for(i = 0; text[i] != '\0'; i++) {
        if(text[i] >= 'A' && text[i] <= 'Z')
            result[i] = (text[i] - 'A' + k) % 26 + 'A';
        else if(text[i] >= 'a' && text[i] <= 'z')
            result[i] = (text[i] - 'a' + k) % 26 + 'a';
        else
            result[i] = text[i];
    }

    result[i] = '\0';

    printf("Ciphertext: %s", result);

    return 0;
}
