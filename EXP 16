#include <stdio.h>
#include <ctype.h>

int main() {

    char text[500];
    int freq[26] = {0};
    int i, total = 0;

    printf("Enter ciphertext:\n");
    fgets(text, sizeof(text), stdin);

    for(i = 0; text[i] != '\0'; i++) {

        if(isalpha(text[i])) {
            freq[toupper(text[i])-'A']++;
            total++;
        }
    }

    printf("\nLetter Frequency:\n");

    for(i = 0; i < 26; i++) {
        printf("%c : %d\n", 'A'+i, freq[i]);
    }

    printf("\nMost frequent letters:\n");

    for(i = 0; i < 26; i++) {
        if(freq[i] > 0)
            printf("%c = %d\n", 'A'+i, freq[i]);
    }

    return 0;
}
