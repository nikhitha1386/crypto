#include <stdio.h>
#include <ctype.h>

int main() {

    char text[] = "send more money";

    int key[] = {
        9,0,1,7,23,15,21,14,11,11,2,8,9
    };

    char cipher[50];
    int i, j = 0;

    for(i = 0; text[i] != '\0'; i++) {

        if(isalpha(text[i])) {
            cipher[j] =
                ((text[i]-'a') + key[j]) % 26 + 'a';
            j++;
        }
    }

    cipher[j] = '\0';

    printf("Plaintext: send more money\n");

    printf("Ciphertext: %s\n", cipher);

    return 0;
}
