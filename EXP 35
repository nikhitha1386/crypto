#include <stdio.h>
#include <ctype.h>

int main() {

    char plaintext[100];
    int key[100];
    int n, i, j = 0;

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    printf("Enter number of key values: ");
    scanf("%d", &n);

    printf("Enter key values:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &key[i]);

    printf("\nCiphertext: ");

    for(i = 0; plaintext[i] != '\0'; i++) {

        if(isalpha(plaintext[i])) {

            char c = tolower(plaintext[i]);

            c = (c - 'a' + key[j]) % 26 + 'a';

            printf("%c", c);

            j++;
        }
    }

    printf("\n");

    return 0;
}
