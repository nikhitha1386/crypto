#include <stdio.h>

int main() {

    int message = 100;

    int k1 = 7;
    int k2 = 11;

    int r1 = 20;
    int s1 = 15;

    int r2 = 25;
    int s2 = 8;

    printf("Message = %d\n", message);

    printf("\nFirst Signature:\n");
    printf("k = %d\n", k1);
    printf("(r,s) = (%d,%d)\n", r1, s1);

    printf("\nSecond Signature:\n");
    printf("k = %d\n", k2);
    printf("(r,s) = (%d,%d)\n", r2, s2);

    printf("\nSame message, different signatures.\n");

    return 0;
}
